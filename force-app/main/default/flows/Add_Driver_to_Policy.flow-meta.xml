<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Given a driver&apos;s first name, last name, email, phone number, driver&apos;s license number, license expiry date an license issue date, add the driver to the provided existing auto insurance policy. Also create a case for validating the new driver</description>
    <environments>Default</environments>
    <interviewLabel>Add Driver to Policy {!$Flow.CurrentDateTime}</interviewLabel>
    <label>INS - Add Driver to Policy</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Case</name>
        <label>Create Case</label>
        <locationX>176</locationX>
        <locationY>674</locationY>
        <assignRecordIdToReference>caseId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_Case_Number</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>driverAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>driverContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>caseDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Add Driver to Auto Policy</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Driver</name>
        <label>Create Driver</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignRecordIdToReference>driverAccountId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_Driver_Contact_ID</targetReference>
        </connector>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>firstName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>lastName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PersonEmail</field>
            <value>
                <elementReference>email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone</field>
            <value>
                <elementReference>phone</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Driver_Identity_Document</name>
        <label>Create Driver Identity Document</label>
        <locationX>176</locationX>
        <locationY>566</locationY>
        <connector>
            <targetReference>Create_Case</targetReference>
        </connector>
        <inputAssignments>
            <field>ExpirationDate</field>
            <value>
                <elementReference>licenseExpiryDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IdDocumentType</field>
            <value>
                <stringValue>Driving License</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IssueDate</field>
            <value>
                <elementReference>LicenseIssueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>DriversLicense</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RelatedLegalEntityId</field>
            <value>
                <elementReference>driverContactId</elementReference>
            </value>
        </inputAssignments>
        <object>IdentityDocument</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Policy_Participant_record</name>
        <label>Create Policy Participant record</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <assignRecordIdToReference>policyParticipantId</assignRecordIdToReference>
        <connector>
            <targetReference>Create_Driver_Identity_Document</targetReference>
        </connector>
        <inputAssignments>
            <field>InsurancePolicyId</field>
            <value>
                <elementReference>policyId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsActiveParticipant</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PrimaryParticipantAccountId</field>
            <value>
                <elementReference>Get_Insurance_Policy.NameInsured.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PrimaryParticipantContactId</field>
            <value>
                <elementReference>Get_Insurance_Policy.NameInsured.PersonContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RelatedParticipantAccountId</field>
            <value>
                <elementReference>driverAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RelatedParticipantContactId</field>
            <value>
                <elementReference>driverContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Role</field>
            <value>
                <stringValue>Driver</stringValue>
            </value>
        </inputAssignments>
        <object>InsurancePolicyParticipant</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Case_Number</name>
        <label>Get Case Number</label>
        <locationX>176</locationX>
        <locationY>782</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>caseId</elementReference>
            </value>
        </filters>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>caseNumber</assignToReference>
            <field>CaseNumber</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Driver_Contact_ID</name>
        <label>Get Driver Contact ID</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Policy_Participant_record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>driverAccountId</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputAssignments>
            <assignToReference>driverContactId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Insurance_Policy</name>
        <label>Get Insurance Policy</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Driver</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>policyId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>InsurancePolicy</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Insurance_Policy</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>caseDescription</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Details of driver to add to the {!Get_Insurance_Policy.Name} Auto Policy&lt;/p&gt;&lt;p&gt;Driver Name: {!firstName} {!lastName}&lt;/p&gt;&lt;p&gt;Email Address: {!email}&lt;/p&gt;&lt;p&gt;Phone: {!phone}&lt;/p&gt;&lt;p&gt;Driver&apos;s License Number: {!DriversLicense}&lt;/p&gt;&lt;p&gt;License Issue Date: {!LicenseIssueDate}&lt;/p&gt;&lt;p&gt;License Expiration Date: {!licenseExpiryDate}&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>caseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Newly created case number for validating the driver is added to the auto insurance policy</description>
        <name>caseNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>driverAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>driverContactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Driver&apos;s License Number</description>
        <name>DriversLicense</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Driver&apos;s email address</description>
        <name>email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>First name of driver</description>
        <name>firstName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Last name of driver</description>
        <name>lastName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Driver&apos;s license expiry date</description>
        <name>licenseExpiryDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Driver&apos;s license issue date</description>
        <name>LicenseIssueDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Driver&apos;s phone number</description>
        <name>phone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Id of Insurance Policy to add driver to</description>
        <name>policyId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>policyParticipantId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
