                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style=&quot;color: rgb(7, 55, 99); font-size: 24px; font-family: tahoma;&quot;&gt;Learning Resources&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://trailhead.salesforce.com/content/learn/trails/get-ready-for-agentforce&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 18px; font-family: tahoma;&quot;&gt;Get Ready for Agentforce&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Discover the transformative power of AI agents and learn how to harness them in practical applications. Gain foundational knowledge of generative AI, and get hands-on experience by launching your very first agent.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://trailhead.salesforce.com/content/learn/projects/quick-start-prompt-builder&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 18px; font-family: tahoma;&quot;&gt;Prompt Builder&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Create and test a prompt template for summarizing support cases with generative AI.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://sfdc.co/Multimodality-with-Agentforce&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 18px; font-family: tahoma;&quot;&gt;Turn PDFs &amp;amp; Images into AI-Powered Insights through Multimodality&lt;/a&gt;&lt;/p&gt;&lt;p&gt;See how PDFs &amp;amp; images can be analyzed in real-time. Learn also about the practical applications into how multimodality can provide value to financial services organizations.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://www.salesforce.com/agentforce/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(1, 118, 211); font-family: tahoma; font-size: 18px;&quot;&gt;Complete Guide to Agentforce&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(11, 11, 11); font-size: 12px;&quot;&gt;Humans with Agents drive customer success together. Build and customize autonomous AI agents to support your employees and customers 24/7.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://sfdc.co/PromptBuilderUltimateGuide&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 18px; font-family: tahoma;&quot;&gt;﻿Ultimate Guide to Prompt Builder&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Provides the foundation for Prompt Builder &amp;amp; best practices to create, manage, test &amp;amp; refine prompt templates.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://github.com/trailheadapps/agent-script-recipes&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 18px; font-family: tahoma;&quot;&gt;Agentbuilder Recipes&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Explore a range of Agent configurations through Agentscript, leveraging deterministic and heuristic guardrails.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://trailhead.salesforce.com/users/strailhead/trailmixes/unlock-your-data-with-data-cloud&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 18px; font-family: tahoma;&quot;&gt;Unlock Your Data with Data Cloud&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Unify data from across your platforms with Data Cloud. Get hands-on and study for certification.&lt;/p&gt;</value>
